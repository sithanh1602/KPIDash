PORT=3001
NODE_ENV=development

# MySQL 8
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=anno_kpi_v2
MYSQL_USER=
MYSQL_PASSWORD=

# Hai chuỗi khác nhau, mỗi chuỗi >= 32 ký tự: openssl rand -hex 32
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Tài khoản Leader đầu tiên (tạo bởi npm run db:init)
ADMIN_EMAIL=
ADMIN_NAME=
ADMIN_PASSWORD=

# Redis Cache & Session (Hỗ trợ 10 người dùng)
REDIS_ENABLED=true
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_KEY_PREFIX=annokpi:
REDIS_MAX_USERS=10

